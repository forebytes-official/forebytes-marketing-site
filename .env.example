# Production domain, used for canonical URLs, the sitemap, Open Graph and structured data.
# forebytes.com serves this site directly on both the apex and www (no redirect).
NEXT_PUBLIC_SITE_URL=https://forebytes.com

# --- Server-only (Vercel env vars, never a NEXT_PUBLIC_ variable) ---
# Waitlist storage. Without these, production signups fail (local dev writes data/waitlist.jsonl instead).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: for each new waitlist signup, email the team and send the visitor a welcome email (Brevo).
# Create a key in Brevo > SMTP & API > API Keys. Without BREVO_API_KEY neither is sent; signups still work.
BREVO_API_KEY=
# Comma-separated recipients (default support@forebytes.com) and a sender on the verified forebytes.com domain.
WAITLIST_NOTIFY_TO=
WAITLIST_NOTIFY_FROM=

# Apple Developer Team ID (10 characters, developer.apple.com > Membership). Needed for universal links:
# without it /.well-known/apple-app-site-association returns 404 on purpose.
APPLE_TEAM_ID=
